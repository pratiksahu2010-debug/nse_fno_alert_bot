UPSTOX_ACCESS_TOKEN=replace_with_upstox_analytics_token
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
UNIVERSE_PATH=config/nse_fno_universe.json
ORB_RANGE_MINUTES=15
ORB_ENTRY_CUTOFF=11:30
MOMENTUM_ENTRY_CUTOFF=15:00
MOMENTUM_COOLDOWN_MINUTES=30
RELATIVE_VOLUME_THRESHOLD=1.5
ATR_EXPANSION_THRESHOLD=1.2
STRUCTURE_LOOKBACK=10
ATR_PERIOD=14
EMA_FAST=9
EMA_SLOW=21
GAP_MIN_PCT=1.0
SL_ATR_BUFFER=0.2
TARGET_1_R=1.0
TARGET_2_R=2.0
WEBSOCKET_STALE_SECONDS=90
